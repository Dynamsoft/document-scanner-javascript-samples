<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<system.webServer>
		<!-- Cross-origin isolation, as in vite.config.ts. -->
		<httpProtocol>
			<customHeaders>
				<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				<add name="Cross-Origin-Embedder-Policy" value="credentialless" />
			</customHeaders>
		</httpProtocol>
		<rewrite>
			<rules>
				<rule name="Redirect multi-page-scanner to root" stopProcessing="true">
					<match url="^multi-page-scanner(/.*)?$" ignoreCase="true" />
					<action type="Redirect" url="/document-scanner/" appendQueryString="false" redirectType="Permanent" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
</configuration>
