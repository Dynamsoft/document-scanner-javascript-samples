<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<system.webServer>
		<staticContent>
			<remove fileExtension=".data" />
			<mimeMap fileExtension=".data" mimeType="application/octet-stream" />
		</staticContent>
		<rewrite>
			<rules>
				<rule name="Redirect multi-page-scanner to root" stopProcessing="true">
					<match url="^multi-page-scanner(/.*)?$" ignoreCase="true" />
					<action type="Redirect" url="/document-scanner/" appendQueryString="false" redirectType="Permanent" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
</configuration>
